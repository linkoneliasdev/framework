RewriteEngine On
RewriteBase /

# Bloqueia acesso HTTP direto a pastas e arquivos internos.
RewriteRule ^app/ - [F,END]
RewriteRule ^vendor/ - [F,END]
RewriteRule ^storage/ - [F,END]
RewriteRule ^pages/ - [F,END]
RewriteRule ^\.env(?:\..*)?$ - [F,END]
RewriteRule ^up\.sh$ - [F,END]
RewriteRule ^composer\.(?:json|lock)$ - [F,END]

# Páginas públicas de autenticação.
# END evita que os destinos internos sejam processados novamente pelas regras.
RewriteRule ^login$ pages/auth/login.php [END]
RewriteRule ^registrar$ pages/auth/registrar.php [END]
RewriteRule ^forgot$ pages/auth/forgot.php [END]

# Endpoints da API são acessados diretamente por suas rotas.
RewriteRule ^api/ - [END]

# Arquivos públicos existentes (CSS, JS, imagens etc.).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

# Demais URLs passam pelo roteador protegido.
RewriteRule ^(.*)$ index.php?pagina=$1 [END,QSA]
